{
    "manifest_version": 3,
    "name": "Meown't",
    "version": "1.0",
    "action": {"default_popup": "popup.html"},
    "permissions": [
        "scripting"
    ],
    "icons": {
        "16": "images/16.png",
        "48": "images/48.png",
        "128": "images/128.png"
    },
    "optional_host_permissions": ["*://*/*"],
    "background": {"service_worker": "background.js"},
    "web_accessible_resources": [
    {
        "resources": ["images/*"],
        "matches": ["<all_urls>"]
    }
]


}